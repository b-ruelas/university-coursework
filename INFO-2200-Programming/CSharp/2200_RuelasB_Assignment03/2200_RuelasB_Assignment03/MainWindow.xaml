<Window x:Class="_2200_RuelasB_Assignment03.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:_2200_RuelasB_Assignment03"
        mc:Ignorable="d"
        Title="MainWindow" Height="450" Width="800">
    <Grid RenderTransformOrigin="0.538,0.537">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Orientation="Horizontal"
                    HorizontalAlignment="Center"
                    Margin="0,0,0,10">
            <RadioButton x:Name="rbDog"
                         Content="Dog"
                         Margin="20,0"
                         Checked="Animal_Checked"/>
            <RadioButton x:Name="rbCat"
                         Content="Cat"
                         Margin="20,0"
                         Checked="Animal_Checked"/>
            <RadioButton x:Name="rbChicken"
                         Content="Chicken"
                         Margin="20,0"
                         Checked="Animal_Checked"/>
        </StackPanel>
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="267*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="197*"/>
                <ColumnDefinition Width="267*"/>
            </Grid.ColumnDefinitions>

            <GroupBox Header="Base Class Properties" Margin="5,5,5,5">
                <StackPanel>
                    <Button Content="SkinType" Click="BtnSkin_Click" Margin="5" Width="130"/>
                    <Button Content="FoodType" Click="BtnFood_Click" Margin="5" Width="130"/>

                </StackPanel>
            </GroupBox>
            <GroupBox Header="Base Class Methods" Grid.Column="1" Margin="5,5,5,5" Grid.ColumnSpan="2">
                <StackPanel>
                    <Button Content="Eat" Click="BtnEat_Click" Margin="5" Width="110"/>
                    <Button Content="Move" Click="BtnMove_Click" Margin="5" Width="110"/>
                    <Button Content="Reproduce" Click="BtnReproduce_Click" Margin="5" Width="110"/>
                </StackPanel>
            </GroupBox>
            <GroupBox Header="Derived Class Overrides" Grid.Column="3" Margin="5,5,5,5">
                <StackPanel>
                    <Button Content="Unique" Click="BtnUnique_Click" Margin="5" Width="130"/>
                </StackPanel>
            </GroupBox>
            <StackPanel Grid.ColumnSpan="4" Margin="240,142,268,-142">
                <Image x:Name="imgAnimal"
               Stretch="Uniform"
               MaxHeight = "250"
               HorizontalAlignment="Left"
               VerticalAlignment="Center"
               Grid.Row="3"
               Grid.ColumnSpan="4"/>
            </StackPanel>

            <TextBlock x:Name="txtResult"
                   FontSize="16"
                   HorizontalAlignment="center"
                       VerticalAlignment="Center"
                   Margin="5,323,0,-243" Width="287" Grid.ColumnSpan="3" Grid.Column="1"/>
        </Grid>

    </Grid>
</Window>